{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dachnaya",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "073d6238-93fe-4254-ac1e-986813b14949","database_name": "dachnaya" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "eaa779587320417890edc69eb5325585" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
